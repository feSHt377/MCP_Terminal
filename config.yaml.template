# mcpterminal 配置文件模板 — MCP 远程终端 / Agent 执行基础设施
# 使用方式：复制此文件为 config.yaml 并填入真实值

app:
  name: mcpterminal
  theme: dark  # dark | light

servers:
  # ---- 示例配置（请替换为你的服务器信息）----
  demo-server:
    host: <your-server-ip>
    port: 22
    user: <your-username>
    # hide: true            # 设为 true 则在 UI 中隐藏该服务器
    # key_path: ~/.ssh/id_rsa   # SSH 私钥（与 password 二选一）
    password: <your-password>   # 密码（不推荐明文存储，建议使用 key_path）

ai:
  provider: claude  # claude | codex | custom
  model: claude-sonnet-4-20250514
  # api_key: 从环境变量读取

mcp:
  port: 5000

security:
  # ---- 需要确认的危险命令 ----
  dangerous_commands:
    - rm
    - shutdown
    - reboot
    - iptables
    - mkfs
    - fdisk
    - dd
    - chmod 777
    - systemctl stop
    - systemctl disable

  # ---- 风险等级分类 ----
  risk_levels:
    low:
      - ls
      - cat
      - df
      - ps
      - status
      - show
      - list
    medium:
      - systemctl restart
      - systemctl reload
      - apt install
      - pip install
      - docker restart
    high:
      - rm
      - shutdown
      - reboot
      - iptables
      - mkfs
      - fdisk
      - dd

logging:
  path: ./logs
  level: INFO
