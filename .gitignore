# 隐藏文件夹（以 . 开头）
.*/

# 例外：GitHub 配置与 Agent 定义
!.github/

# 日志文件
*.txt
logs/

# 例外：requirements.txt 必须纳入版本控制（更新/分发依赖它）
!requirements.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.spec

# 虚拟环境
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
.runtime/

# 模板目录
Template/

# 配置文件（含敏感信息，仅保留模板）
config.yaml
